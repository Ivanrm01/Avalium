---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Actualidad Tributaria — Avalium</title>
    <link>https://www.avalium.es/blog</link>
    <atom:link href="https://www.avalium.es/feed.xml" rel="self" type="application/rss+xml" />
    <description>Análisis técnicos sobre suspensión de deudas AEAT, aplazamientos, hipoteca unilateral y operaciones societarias.</description>
    <language>es-ES</language>
    <lastBuildDate>{{ page.date | dateRFC }}</lastBuildDate>
{%- for post in collections.posts %}
{%- if not post.data.noindex %}
    <item>
      <title>{{ post.data.title | escape }}</title>
      <link>{{ post.url | absUrl }}</link>
      <guid isPermaLink="true">{{ post.url | absUrl }}</guid>
      <pubDate>{{ post.date | dateRFC }}</pubDate>
      <category>{{ post.data.tag | escape }}</category>
      <description>{{ (post.data.summary or post.data.lede) | plain | escape }}</description>
    </item>
{%- endif %}
{%- endfor %}
  </channel>
</rss>
