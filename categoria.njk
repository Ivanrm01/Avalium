---
pagination:
  data: collections.categoriaPaginas
  size: 1
  alias: cat
permalink: "{% if cat.numero == 1 %}/blog/categoria/{{ cat.slug }}/index.html{% else %}/blog/categoria/{{ cat.slug }}/pagina-{{ cat.numero }}.html{% endif %}"
eleventyExcludeFromCollections: true
---
{%- set esPrimera = cat.numero == 1 -%}
{%- set baseUrl = "/blog/categoria/" + cat.slug -%}
{%- set urlActual = baseUrl if esPrimera else baseUrl + "/pagina-" + cat.numero -%}
{%- set tituloPagina = cat.tag if esPrimera else cat.tag + " — Página " + cat.numero + " de " + cat.total -%}
{%- set descripcionPagina = "Artículos y análisis técnicos de Avalium sobre " + cat.tag + ". Contenido escrito a partir de casos reales, normativa vigente y criterio administrativo." -%}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="icon" href="/assets/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/icon-192.png">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ tituloPagina }} | Blog tributario de Avalium</title>
<meta name="description" content="{{ descripcionPagina | recorte(155) }}">
<link rel="canonical" href="{{ urlActual | absUrl }}">
{%- if cat.indexable %}
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
{%- else %}
{# Categoría con pocos artículos: se puede navegar, pero no se indexa
   para no generar páginas de contenido pobre. Pasará a indexarse sola
   al alcanzar el umbral definido en .eleventy.js #}
<meta name="robots" content="noindex, follow">
{%- endif %}
{%- if cat.numero > 1 %}
<link rel="prev" href="{% if cat.numero == 2 %}{{ baseUrl | absUrl }}{% else %}{{ (baseUrl + "/pagina-" + (cat.numero - 1)) | absUrl }}{% endif %}">
{%- endif %}
{%- if cat.numero < cat.total %}
<link rel="next" href="{{ (baseUrl + "/pagina-" + (cat.numero + 1)) | absUrl }}">
{%- endif %}
<link rel="alternate" type="application/rss+xml" title="Actualidad Tributaria — Avalium" href="/feed.xml">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ urlActual | absUrl }}">
  <meta property="og:title" content="{{ tituloPagina }} | Avalium">
  <meta property="og:description" content="{{ descripcionPagina | recorte(155) }}">
  <meta property="og:image" content="https://www.avalium.es/assets/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="Avalium Consulting Group">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ tituloPagina }} | Avalium">
  <meta name="twitter:description" content="{{ descripcionPagina | recorte(155) }}">
  <meta name="twitter:image" content="https://www.avalium.es/assets/og-image.jpg">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ (urlActual | absUrl) | json | safe }},
      "url": {{ (urlActual | absUrl) | json | safe }},
      "name": {{ tituloPagina | json | safe }},
      "description": {{ descripcionPagina | json | safe }},
      "isPartOf": { "@id": "https://www.avalium.es/blog#blog" },
      "inLanguage": "es-ES",
      "about": { "@type": "Thing", "name": {{ cat.tag | json | safe }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ cat.posts.length }},
        "itemListElement": [
          {%- for post in cat.posts %}
          {
            "@type": "ListItem",
            "position": {{ loop.index + ((cat.numero - 1) * site.porPagina) }},
            "url": {{ (post.url | absUrl) | json | safe }},
            "name": {{ post.data.title | json | safe }}
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.avalium.es/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.avalium.es/blog" },
        { "@type": "ListItem", "position": 3, "name": {{ cat.tag | json | safe }}, "item": {{ (baseUrl | absUrl) | json | safe }} }
      ]
    }
  ]
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
{% include "partials/estilos-blog.njk" %}
  <!-- Analitica cargada solo tras consentimiento: ver /assets/cookies.js -->
  <script src="/assets/cookies.js"></script>
</head>
<body>

{% include "partials/cabecera.njk" %}

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Inicio</a><span>/</span><a href="/blog">Blog</a><span>/</span>
      {%- if esPrimera -%}
      <span>{{ cat.tag }}</span>
      {%- else -%}
      <a href="{{ baseUrl }}">{{ cat.tag }}</a><span>/</span><span>Página {{ cat.numero }}</span>
      {%- endif -%}
    </div>
    <div class="page-hero-grid">
      <div class="reveal">
        <span class="eyebrow">— CATEGORÍA</span>
        <h1 style="margin-top: 1.25rem;">{{ cat.tag }}{% if not esPrimera %} <span style="font-size:0.5em; color:var(--muted); font-family:var(--font-body); font-style:normal; display:block; margin-top:0.75rem;">Página {{ cat.numero }} de {{ cat.total }}</span>{% endif %}</h1>
      </div>
      <div class="reveal reveal-delay-1">
        <p class="lede">{{ descripcionPagina }}</p>
      </div>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container">

    {%- set tagActiva = cat.tag -%}
    {% include "partials/filtro-categorias.njk" %}

    <div class="cards-grid">
      {%- for post in cat.posts -%}
        <a href="{{ post.url | clean }}" class="card reveal">
          <span class="card-tag">— {{ post.data.tag }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.summary or post.data.lede | striptags | truncate(160) }}</p>
          <div class="card-meta"><span>{{ post.data.reading_time }}</span><span>{{ post.data.date | dateFormat }}</span></div>
        </a>
      {%- endfor -%}
    </div>

    {%- set paginaActual = cat.numero -%}
    {%- set totalPaginas = cat.total -%}
    {% include "partials/paginacion.njk" %}

    <div style="margin-top: 4rem; text-align: center;" class="reveal">
      <a href="/blog" class="btn btn-ghost">Ver todos los artículos <span class="arrow">→</span></a>
    </div>

  </div>
</section>

{% include "partials/pie.njk" %}

<script>
const reveals = document.querySelectorAll('.reveal');
if (reveals.length) {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
  reveals.forEach(el => observer.observe(el));
}
</script>
<script src="/assets/menu.js"></script>
</body>
</html>
