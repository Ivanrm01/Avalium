---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
paginas:
  - { url: "/", priority: "1.0", changefreq: "monthly" }
  - { url: "/suspension-deudas-aeat", priority: "0.9", changefreq: "monthly" }
  - { url: "/aplazamiento-fraccionamiento-aeat", priority: "0.9", changefreq: "monthly" }
  - { url: "/ampliacion-capital-garantia-inmobiliaria", priority: "0.9", changefreq: "monthly" }
  - { url: "/hipoteca-unilateral", priority: "0.9", changefreq: "monthly" }
  - { url: "/casos-de-exito", priority: "0.8", changefreq: "monthly" }
  - { url: "/contacto", priority: "0.8", changefreq: "monthly" }
  - { url: "/blog", priority: "0.8", changefreq: "weekly" }
  - { url: "/sobre-nosotros", priority: "0.7", changefreq: "monthly" }
  - { url: "/equipo", priority: "0.7", changefreq: "monthly" }
  - { url: "/legal/aviso-legal", priority: "0.3", changefreq: "yearly" }
  - { url: "/legal/privacidad", priority: "0.3", changefreq: "yearly" }
  - { url: "/legal/cookies", priority: "0.3", changefreq: "yearly" }
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in paginas %}
  <url>
    <loc>https://www.avalium.es{{ p.url }}</loc>
    <lastmod>{{ page.date | dateISO }}</lastmod>
    <changefreq>{{ p.changefreq }}</changefreq>
    <priority>{{ p.priority }}</priority>
  </url>
{%- endfor %}
{#- Páginas de categoría: solo las que superan el umbral de indexación -#}
{%- for cat in collections.categoriaPaginas %}
{%- if cat.indexable and cat.numero == 1 %}
  <url>
    <loc>https://www.avalium.es/blog/categoria/{{ cat.slug }}</loc>
    <lastmod>{{ (cat.posts[0].data.updated or cat.posts[0].date) | dateISO }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endif %}
{%- endfor %}
{#- Artículos del blog -#}
{%- for post in collections.posts %}
{%- if not post.data.noindex %}
  <url>
    <loc>{{ post.url | absUrl }}</loc>
    <lastmod>{{ (post.data.updated or post.date) | dateISO }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
