---
pagination:
  data: collections.blogPaginas
  size: 1
  alias: pagina
permalink: "{% if pagina.numero == 1 %}/blog/index.html{% else %}/blog/pagina-{{ pagina.numero }}.html{% endif %}"
eleventyExcludeFromCollections: true
---
{%- set esPrimera = pagina.numero == 1 -%}
{%- set baseUrl = "/blog" -%}
{%- set urlActual = baseUrl if esPrimera else baseUrl + "/pagina-" + pagina.numero -%}
{%- set tituloPagina = "Actualidad Tributaria" if esPrimera else "Actualidad Tributaria — Página " + pagina.numero + " de " + pagina.total -%}
{%- set descripcionPagina = "Análisis técnicos sobre suspensión AEAT, aplazamientos, hipoteca unilateral y operaciones societarias. Publicaciones tributarias de Avalium." if esPrimera else "Página " + pagina.numero + " del archivo de análisis tributarios de Avalium: suspensión AEAT, aplazamientos, hipoteca unilateral y operaciones societarias." -%}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="icon" href="/assets/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/icon-192.png">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ tituloPagina }} | Avalium</title>
<meta name="description" content="{{ descripcionPagina }}">
<link rel="canonical" href="{{ urlActual | absUrl }}">
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
{%- if pagina.numero > 1 %}
<link rel="prev" href="{% if pagina.numero == 2 %}{{ baseUrl | absUrl }}{% else %}{{ (baseUrl + "/pagina-" + (pagina.numero - 1)) | absUrl }}{% endif %}">
{%- endif %}
{%- if pagina.numero < pagina.total %}
<link rel="next" href="{{ (baseUrl + "/pagina-" + (pagina.numero + 1)) | absUrl }}">
{%- endif %}
<link rel="alternate" type="application/rss+xml" title="Actualidad Tributaria — Avalium" href="/feed.xml">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ urlActual | absUrl }}">
  <meta property="og:title" content="Avalium | {{ tituloPagina }}">
  <meta property="og:description" content="{{ descripcionPagina }}">
  <meta property="og:image" content="https://www.avalium.es/assets/og-image.jpg">
  <meta property="og:image:secure_url" content="https://www.avalium.es/assets/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="Avalium Consulting Group">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Avalium | {{ tituloPagina }}">
  <meta name="twitter:description" content="Análisis técnicos sobre hipoteca unilateral, aplazamientos AEAT y operaciones societarias.">
  <meta name="twitter:image" content="https://www.avalium.es/assets/og-image.jpg">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": "https://www.avalium.es/blog#blog",
      "url": "https://www.avalium.es/blog",
      "name": "Actualidad Tributaria — Avalium",
      "description": "Análisis técnicos sobre suspensión de deudas AEAT, aplazamientos y fraccionamientos, hipoteca unilateral y operaciones societarias.",
      "inLanguage": "es-ES",
      "publisher": {
        "@type": "Organization",
        "name": "Avalium Consulting Group",
        "url": "https://www.avalium.es",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.avalium.es/assets/logo.png"
        }
      }
    },
    {
      "@type": "CollectionPage",
      "@id": {{ (urlActual | absUrl) | json | safe }},
      "url": {{ (urlActual | absUrl) | json | safe }},
      "name": {{ tituloPagina | json | safe }},
      "isPartOf": { "@id": "https://www.avalium.es/blog#blog" },
      "inLanguage": "es-ES",
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ pagina.posts.length }},
        "itemListElement": [
          {%- for post in pagina.posts %}
          {
            "@type": "ListItem",
            "position": {{ loop.index + ((pagina.numero - 1) * site.porPagina) }},
            "url": {{ (post.url | absUrl) | json | safe }},
            "name": {{ post.data.title | json | safe }}
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.avalium.es/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.avalium.es/blog" }
        {%- if not esPrimera %},
        { "@type": "ListItem", "position": 3, "name": {{ ("Página " + pagina.numero) | json | safe }}, "item": {{ (urlActual | absUrl) | json | safe }} }
        {%- endif %}
      ]
    }
  ]
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
{% include "partials/estilos-blog.njk" %}
  <!-- Analitica cargada solo tras consentimiento: ver /assets/cookies.js -->
  <script src="/assets/cookies.js"></script>
</head>
<body>

{% include "partials/cabecera.njk" %}

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Inicio</a><span>/</span>
      {%- if esPrimera -%}
      <span>Blog</span>
      {%- else -%}
      <a href="/blog">Blog</a><span>/</span><span>Página {{ pagina.numero }}</span>
      {%- endif -%}
    </div>
    <div class="page-hero-grid">
      <div class="reveal">
        <span class="eyebrow">— BLOG TRIBUTARIO</span>
        <h1 style="margin-top: 1.25rem;">Notas técnicas sobre <em>derecho tributario</em> aplicado.{% if not esPrimera %} <span style="font-size:0.5em; color:var(--muted); font-family:var(--font-body); font-style:normal; display:block; margin-top:0.75rem;">Página {{ pagina.numero }} de {{ pagina.total }}</span>{% endif %}</h1>
      </div>
      <div class="reveal reveal-delay-1">
        <p class="lede">Cada artículo nace de un caso real, una duda repetida o un cambio normativo que afecta a empresas, particulares y autónomos.</p>
      </div>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container">

    {# El artículo destacado solo se muestra en la primera página #}
    {%- if esPrimera -%}
    {%- set featuredPost = collections.posts | featuredPost -%}
    {%- if featuredPost -%}
    <article class="featured reveal">
      <a href="{{ featuredPost.url | clean }}" class="featured-visual">
        {%- if featuredPost.data.featured_quote -%}
        <p class="featured-quote">{{ featuredPost.data.featured_quote | safe }}</p>
        {%- else -%}
        <p class="featured-quote">"{{ featuredPost.data.title }}"</p>
        {%- endif -%}
      </a>
      <div>
        <span class="featured-tag">— Destacado · {{ featuredPost.data.tag }}</span>
        <h2><a href="{{ featuredPost.url | clean }}">{{ featuredPost.data.title }}</a></h2>
        <p style="color: var(--navy-soft); margin-bottom: 1.5rem;">{{ featuredPost.data.summary or featuredPost.data.lede | striptags }}</p>
        <div style="display: flex; gap: 1.5rem; font-size: 0.85rem; color: var(--muted); margin-bottom: 1.5rem;">
          <span>Equipo Avalium</span><span>·</span><span>{{ featuredPost.data.reading_time }} lectura</span><span>·</span><span>{{ featuredPost.data.date | dateFormat }}</span>
        </div>
        <a href="{{ featuredPost.url | clean }}" class="btn btn-ghost">Leer artículo <span class="arrow">→</span></a>
      </div>
    </article>
    {%- endif -%}
    {%- endif -%}

    {%- set tagActiva = "" -%}
    {% include "partials/filtro-categorias.njk" %}

    {%- if pagina.posts.length == 0 -%}
    <div class="empty-state">
      <p>Aún no hay artículos publicados.</p>
    </div>
    {%- else -%}
    <div class="cards-grid" id="posts-grid">
      {%- for post in pagina.posts -%}
        <a href="{{ post.url | clean }}" class="card reveal" data-category="{{ post.data.tag }}">
          <span class="card-tag">— {{ post.data.tag }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.summary or post.data.lede | striptags | truncate(160) }}</p>
          <div class="card-meta"><span>{{ post.data.reading_time }}</span><span>{{ post.data.date | dateFormat }}</span></div>
        </a>
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- set paginaActual = pagina.numero -%}
    {%- set totalPaginas = pagina.total -%}
    {% include "partials/paginacion.njk" %}

    <div style="margin-top: 4rem; text-align: center;" class="reveal">
      <p style="color: var(--muted); font-size: 0.9rem; margin-bottom: 1.25rem;">¿Quieres recibir el próximo análisis directamente en tu email?</p>
      <a href="/contacto" class="btn btn-ghost">Suscribirse a la newsletter <span class="arrow">→</span></a>
    </div>

  </div>
</section>

{% include "partials/pie.njk" %}

<script>
// Animación reveal al hacer scroll
const reveals = document.querySelectorAll('.reveal');
if (reveals.length) {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
  reveals.forEach(el => observer.observe(el));
}
</script>
<script src="/assets/menu.js"></script>
</body>
</html>
