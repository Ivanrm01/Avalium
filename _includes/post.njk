{#
  PLANTILLA DE ARTÍCULO
  Todos los campos SEO son opcionales y tienen valor por defecto:
    seo_title        -> título para Google (si no, se usa `title`)
    meta_description -> descripción para Google (si no, `summary` y luego `lede`)
    image            -> imagen para redes sociales (si no, la genérica)
    image_alt        -> texto alternativo de esa imagen
    updated          -> fecha de última actualización (dateModified)
    author           -> autor con nombre y apellidos (si no, "Equipo Avalium")
    faq              -> lista pregunta/respuesta -> bloque visible + FAQPage
    toc              -> false para ocultar el índice
    noindex          -> true para no indexar el artículo
    canonical        -> URL canónica alternativa (contenido republicado)
#}
{%- set urlAbs = page.url | absUrl -%}
{%- set tituloSeo = seo_title or title -%}
{%- set descripcionSeo = (meta_description or summary or lede) | recorte(155) -%}
{%- set imagenSeo = (image or "/assets/og-image.jpg") | absUrl -%}
{%- set fechaPublicacion = date | dateISOFull -%}
{%- set fechaModificacion = (updated or date) | dateISOFull -%}
{%- set autor = author or "Equipo Avalium" -%}
{%- set indiceArticulo = content | indice -%}
{%- set mostrarIndice = (toc != false) and (indiceArticulo.length >= 3) -%}
{%- set lecturaCalculada = reading_time or (content | tiempoLectura) -%}
{%- set relacionadosFinal = related if (related and related.length > 0) else (collections.posts | relacionados(page.url, tag, 3)) -%}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="icon" href="/assets/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/icon-192.png">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ tituloSeo }} | Avalium</title>
<meta name="description" content="{{ descripcionSeo }}">
<link rel="canonical" href="{{ canonical or urlAbs }}">
{%- if noindex %}
<meta name="robots" content="noindex, follow">
{%- else %}
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
{%- endif %}
<link rel="alternate" type="application/rss+xml" title="Actualidad Tributaria — Avalium" href="/feed.xml">

<!-- Open Graph (LinkedIn, WhatsApp, Facebook, Telegram) -->
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ urlAbs }}">
  <meta property="og:title" content="{{ tituloSeo }} | Avalium">
  <meta property="og:description" content="{{ descripcionSeo }}">
  <meta property="og:image" content="{{ imagenSeo }}">
  <meta property="og:image:secure_url" content="{{ imagenSeo }}">
  <meta property="og:image:alt" content="{{ image_alt or title }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="Avalium Consulting Group">
  <meta property="article:published_time" content="{{ fechaPublicacion }}">
  <meta property="article:modified_time" content="{{ fechaModificacion }}">
  <meta property="article:section" content="{{ tag }}">
  <meta property="article:author" content="{{ autor }}">
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ tituloSeo }} | Avalium">
  <meta name="twitter:description" content="{{ descripcionSeo }}">
  <meta name="twitter:image" content="{{ imagenSeo }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": {{ (urlAbs + "#article") | json | safe }},
      "headline": {{ title | recorte(110) | json | safe }},
      "name": {{ title | json | safe }},
      "description": {{ descripcionSeo | json | safe }},
      "articleSection": {{ tag | json | safe }},
      "inLanguage": "es-ES",
      "wordCount": {{ content | palabras }},
      "datePublished": {{ fechaPublicacion | json | safe }},
      "dateModified": {{ fechaModificacion | json | safe }},
      "url": {{ urlAbs | json | safe }},
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ urlAbs | json | safe }} },
      "image": {
        "@type": "ImageObject",
        "url": {{ imagenSeo | json | safe }},
        "width": 1200,
        "height": 630
      },
      "author": {
        {%- if author %}
        "@type": "Person",
        "name": {{ author | json | safe }},
        "url": "https://www.avalium.es/equipo"
        {%- else %}
        "@type": "Organization",
        "name": "Equipo Avalium",
        "url": "https://www.avalium.es/equipo"
        {%- endif %}
      },
      "publisher": { "@id": "https://www.avalium.es/#organizacion" },
      "isPartOf": { "@id": "https://www.avalium.es/blog#blog" }
    },
    {
      "@type": "Organization",
      "@id": "https://www.avalium.es/#organizacion",
      "name": "Avalium Consulting Group",
      "url": "https://www.avalium.es",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.avalium.es/assets/logo.png"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.avalium.es/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.avalium.es/blog" },
        { "@type": "ListItem", "position": 3, "name": {{ tag | json | safe }}, "item": {{ ("/blog/categoria/" + (tag | slugify)) | absUrl | json | safe }} },
        { "@type": "ListItem", "position": 4, "name": {{ title | json | safe }}, "item": {{ urlAbs | json | safe }} }
      ]
    }
    {%- if faq and faq.length > 0 %},
    {
      "@type": "FAQPage",
      "@id": {{ (urlAbs + "#faq") | json | safe }},
      "mainEntity": [
        {%- for f in faq %}
        {
          "@type": "Question",
          "name": {{ f.pregunta | plain | json | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ f.respuesta | md | plain | json | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
    {%- endif %}
  ]
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<style>
.article-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); padding: 1.25rem 0; border-bottom: 1px solid var(--line); margin-bottom: 2.5rem; }
.article-meta strong { color: var(--navy); }
.related-articles { background: var(--cream-deep); padding: clamp(2.5rem, 5vw, 4rem) 0; border-top: 1px solid var(--line); }

/* Índice del artículo */
.toc { background: var(--cream-deep); border-left: 2px solid var(--terracotta); padding: 1.5rem 1.75rem; margin: 0 0 2.75rem; }
.toc-title { font-family: var(--font-display); font-style: italic; color: var(--navy); font-size: 1.05rem; margin-bottom: 0.9rem; }
.toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; }
.toc li { margin: 0 0 0.5rem; line-height: 1.45; }
.toc li.nivel-3 { margin-left: 1.25rem; font-size: 0.9rem; }
.toc a { color: var(--navy-soft); text-decoration: none; border-bottom: 1px solid transparent; font-size: 0.95rem; transition: color 0.2s, border-color 0.2s; }
.toc a:hover { color: var(--terracotta); border-bottom-color: currentColor; }

/* Preguntas frecuentes */
.faq-block { margin: 3rem 0 0; padding-top: 2.5rem; border-top: 1px solid var(--line); }
.faq-item { border-bottom: 1px solid var(--line); padding: 1.1rem 0; }
.faq-item summary { cursor: pointer; font-weight: 500; color: var(--navy); font-size: 1.05rem; line-height: 1.45; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: '+'; color: var(--terracotta); font-size: 1.3rem; line-height: 1; flex-shrink: 0; }
.faq-item[open] summary::after { content: '−'; }
.faq-item .faq-answer { padding-top: 0.9rem; color: var(--navy-soft); }
.faq-item .faq-answer p:last-child { margin-bottom: 0; }

/* Anclas de los encabezados */
.article-body h2, .article-body h3 { scroll-margin-top: 90px; }
</style>
  <!-- Analitica cargada solo tras consentimiento: ver /assets/cookies.js -->
  <script src="/assets/cookies.js"></script>
</head>
<body>

{% include "partials/cabecera.njk" %}

<section class="page-hero">
  <div class="container-narrow">
    <div class="breadcrumb"><a href="/">Inicio</a><span>/</span><a href="/blog">Blog</a><span>/</span><a href="/blog/categoria/{{ tag | slugify }}">{{ tag }}</a></div>
    <span class="eyebrow">— {{ tag }}</span>
    <h1 style="margin-top: 1rem;">{{ title }}</h1>
    <p class="lede" style="margin-top: 1.5rem;">{{ lede | safe }}</p>
    <div class="article-meta">
      <span><strong>Lectura:</strong> {{ lecturaCalculada }}</span>
      <span><strong>Publicado:</strong> {{ date | dateFormat }}</span>
      {%- if updated %}
      <span><strong>Actualizado:</strong> {{ updated | dateFormat }}</span>
      {%- endif %}
      <span><strong>Por:</strong> {{ autor }}</span>
    </div>
  </div>
</section>

<article class="section">
  <div class="container-narrow article-body">

    {%- if mostrarIndice %}
    <nav class="toc" aria-label="Índice del artículo">
      <p class="toc-title">En este artículo</p>
      <ol>
        {%- for h in indiceArticulo %}
        <li class="nivel-{{ h.nivel }}"><a href="#{{ h.id }}">{{ h.texto }}</a></li>
        {%- endfor %}
      </ol>
    </nav>
    {%- endif %}

    {{ content | safe }}

    {%- if faq and faq.length > 0 %}
    <section class="faq-block">
      <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
      {%- for f in faq %}
      <details class="faq-item">
        <summary>{{ f.pregunta }}</summary>
        <div class="faq-answer">{{ f.respuesta | md | safe }}</div>
      </details>
      {%- endfor %}
    </section>
    {%- endif %}

  </div>
</article>

{% if relacionadosFinal and relacionadosFinal.length > 0 %}
<section class="related-articles">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">— Seguir leyendo</span></div>
      <h2>Artículos <em>relacionados</em>.</h2>
    </div>
    <div class="cards-grid" style="grid-template-columns: repeat({{ relacionadosFinal.length }}, 1fr);">
      {% for r in relacionadosFinal %}
      <a href="/blog/{{ r.slug }}" style="text-decoration: none; color: inherit;">
        <article class="card">
          <span class="card-tag">— {{ r.tag }}</span>
          <h3>{{ r.title }}</h3>
          <div class="card-meta"><span>{% if r.mins %}Lectura · {{ r.mins }}{% endif %}</span><span>Avalium</span></div>
        </article>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="cta-band">
  <div class="container">
    <div style="text-align: center;">
      <span class="eyebrow" style="color: var(--brass);">— Análisis confidencial</span>
      <h2 style="margin-top: 1.5rem; color: var(--cream);">¿Tu caso encaja con<br>lo que has <em style="color: var(--brass);">leído</em>?</h2>
      <p class="lede" style="color: rgba(245, 239, 227, 0.8); margin: 1.5rem auto 2.5rem; max-width: 50ch;">Solicita un análisis confidencial sin compromiso. Te respondemos en 48 horas.</p>
      <a href="/contacto" class="btn">Iniciar análisis confidencial <span class="arrow">→</span></a>
    </div>
  </div>
</section>

{% include "partials/pie.njk" %}

<script src="/assets/menu.js"></script>
</body>
</html>
