{#
  Barra de categorías. Antes eran botones que ocultaban tarjetas con JS;
  ahora son enlaces reales a páginas de categoría indexables, lo que crea
  enlazado interno y permite posicionar cada categoría por separado.
  Espera la variable `tagActiva` (cadena vacía = "Todos").
#}
{%- set tags = collections.posts | uniqueTags -%}
<nav class="filter-bar reveal" aria-label="Categorías del blog">
  <a href="/blog"{% if not tagActiva %} class="active" aria-current="page"{% endif %}>Todos</a>
  {%- for t in tags %}
  <a href="/blog/categoria/{{ t | slugify }}"{% if tagActiva == t %} class="active" aria-current="page"{% endif %}>{{ t }}</a>
  {%- endfor %}
</nav>
