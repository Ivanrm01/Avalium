{#
  Paginación reutilizable.
  Variables esperadas:
    baseUrl       -> "/blog" o "/blog/categoria/aplazamientos"
    paginaActual  -> número de página actual (1..n)
    totalPaginas  -> total de páginas
#}
{%- if totalPaginas > 1 -%}
<nav class="pagination" aria-label="Paginación de artículos">
  {%- if paginaActual > 1 -%}
    {%- set anterior = paginaActual - 1 -%}
    <a class="edge" rel="prev" href="{% if anterior == 1 %}{{ baseUrl }}{% else %}{{ baseUrl }}/pagina-{{ anterior }}{% endif %}">← Anteriores</a>
  {%- endif -%}

  {%- for n in range(1, totalPaginas + 1) -%}
    {%- if n == 1 or n == totalPaginas or (n >= paginaActual - 1 and n <= paginaActual + 1) -%}
      {%- if n == paginaActual -%}
        <span class="current" aria-current="page">{{ n }}</span>
      {%- else -%}
        <a href="{% if n == 1 %}{{ baseUrl }}{% else %}{{ baseUrl }}/pagina-{{ n }}{% endif %}" aria-label="Ir a la página {{ n }}">{{ n }}</a>
      {%- endif -%}
    {%- elif n == paginaActual - 2 or n == paginaActual + 2 -%}
      <span class="gap">…</span>
    {%- endif -%}
  {%- endfor -%}

  {%- if paginaActual < totalPaginas -%}
    {%- set siguiente = paginaActual + 1 -%}
    <a class="edge" rel="next" href="{{ baseUrl }}/pagina-{{ siguiente }}">Siguientes →</a>
  {%- endif -%}
</nav>
<p class="pagination-info">Página {{ paginaActual }} de {{ totalPaginas }}</p>
{%- endif -%}
